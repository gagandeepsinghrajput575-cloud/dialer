# Optional. You can also enter these in the app's Settings page.
SONETEL_USERNAME=you@example.com
SONETEL_PASSWORD=your-password
PORT=3001

# Optional hardening overrides. Both default to locked down; see README → Security.

# Comma-separated list of extra origins allowed to call the API cross-origin.
# Leave unset: the browser client is always same-origin.
# CORS_ORIGIN=https://portal.example.com

# Who may embed the app in an iframe. Defaults to 'none'.
# X-Frame-Options is dropped automatically when this is set, because it cannot
# express an allowlist and would otherwise override the CSP and block the frame.
# FRAME_ANCESTORS=https://*.example.com
