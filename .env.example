# Optional. Everything here can also be entered in the app's Settings page —
# these values only seed the local database when a setting is still empty.
PORT=3001

# Telnyx SIP connection (Credential Auth) — the same account you register in Zoiper / Linphone
# and the one the in-browser softphone uses. Create it in Mission Control: Connections -> SIP.
TELNYX_SIP_SERVER=sip.telnyx.com
TELNYX_SIP_USER=
TELNYX_SIP_PASSWORD=

# Optional: Telnyx v2 API key (KEY...) and the SIP Connection ID, for carrier automation
# (number lookup, connection management). Not needed to place calls.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=

# Your Danish (+45) numbers. CALLER_ID is the primary; the pool is rotated round-robin
# across dials so carriers stop flagging you as "potential spam". Assign these DIDs to the
# SIP connection in Mission Control (Numbers -> your number -> Connection).
TELNYX_CALLER_ID=
TELNYX_CALLER_ID_POOL=

# Post-call copilot. Leave PULSE_AI_PROVIDER=local (the default) to use the built-in
# extractive summarizer; set a provider + key to delegate to a hosted model instead.
PULSE_AI_PROVIDER=local
PULSE_AI_MODEL=
PULSE_AI_API_KEY=

# Operations
BACKUP_RETENTION=14     # how many snapshots to keep in data/backups

# Outbound email. Any SMTP provider works; Gmail needs an App password, not your login.
# Leave SMTP_HOST empty to keep sending disabled — verification still works without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Who may talk to the API. localhost / 127.0.0.1 / ::1 are always allowed, so the
# defaults are safe for a single-user desktop install. Add hostnames (not URLs) here if
# you reach Pulse Dialer from another machine on your network, e.g.
#   PULSE_ALLOWED_HOSTS=mac-mini.local,192.168.1.20
# Suffix rules (leading dot) cover reverse-proxy / preview hosts.
PULSE_ALLOWED_HOSTS=
PULSE_ALLOWED_SUFFIXES=
# Set to 1 to demand the session token from command-line clients too (curl, scripts).
# Off by default so imports from the shell keep working; browsers always need the token.
PULSE_REQUIRE_TOKEN=0
LOG_REQUESTS=1          # set to 0 to silence per-request logs

# Point the app at a different SQLite folder (the test suite uses a temp dir)
# DATA_DIR=./data
