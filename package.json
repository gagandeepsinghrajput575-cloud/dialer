{
  "name": "pulse-dialer",
  "version": "1.0.0",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "app": "vite build && node server/index.js",
    "test": "node test/all-tests.js",
    "test:unit": "node test/run-unit.js",
    "test:telephony": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/unit/telephony-chaos-stress.test.js",
    "test:audio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/unit/native-audio.test.js",
    "test:callpath": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/unit/call-path.test.js",
    "test:backend": "node test/unit/backend-connectivity.test.js",
    "test:native": "bash test/native/cross-compile.sh && bash test/native/dsp/run.sh",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/unit/end-to-end.test.js",
    "test:property": "node test/unit/property.test.js",
    "test:ui": "vite build && node test/ui/dialer-race.test.js",
    "desktop": "node desktop/scripts/run-desktop.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Telnyx & Softphone-powered dialer + mini CRM (layered Express backend, Danish cold-calling superpowers)",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "papaparse": "^5.7.0",
    "sip.js": "^0.21.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "framer-motion": "^13.5.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  }
}
